# Copy to .env (git-ignored) and edit. ./setup-host.sh creates .env for you and fills in what it can detect.
# Read by: docker compose, the shell scripts, the host runner and the ops scripts.

# Absolute path(s) of your media root(s), separated by ":" like PATH (paths containing ":" are not supported):
#   PLEX_MEDIA_DIRS=/Volumes/Movies:/Volumes/TV:/Users/me/Videos
# Each is mounted READ-ONLY into the container at the same path as on this Mac, so library paths in Plex stay valid.
# ./setup-host.sh turns this list into docker-compose.media.yml; re-run it after changing the list.
PLEX_MEDIA_DIRS=/path/to/your/media

# Loads the generated media mounts automatically for every `docker compose` command (written by setup-host.sh).
# Add your own extra compose file to this list (":" separated) if you need other customisations.
COMPOSE_FILE=docker-compose.yml:docker-compose.media.yml

# This Mac's LAN IP, advertised to Plex clients (give it a DHCP reservation).
PLEX_LAN_IP=192.168.1.10

# Time zone for the container (e.g. America/Los_Angeles).
TZ=UTC

# uid/gid of the macOS user that owns this project: the container runs Plex as this user so the shared
# transcode directory is writable on both sides (setup-host.sh uses `id -u` / `id -g`).
PLEX_UID=501
PLEX_GID=20

# Plex Media Server version. MUST equal the version of /Applications/Plex Media Server.app (its Plex Transcoder is
# what runs). Image tag format: <version>-<build>, e.g. 1.43.5.11079-b3b13e506.
PLEX_VERSION=1.43.5.11079-b3b13e506

# Absolute path of this project directory (setup-host.sh sets it).
PLEX_PROJECT_DIR=/path/to/this/project

# Port of the host transcode runner (listens on 127.0.0.1 only).
PLEX_RUNNER_PORT=32499

# Optional, used only by ./seed-config.sh: extra networks (comma separated) to add to Plex's "LAN networks".
PLEX_EXTRA_LAN_NETWORKS=

# SECRET shared between the container and the host runner. Generated by setup-host.sh; never commit.
BRIDGE_TOKEN=
